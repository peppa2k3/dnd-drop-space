# Copy to backend/.env for local use, or to /srv/pkh/shared/backend.env on the VPS.
# Production: NODE_ENV=production and CLIENT_ORIGIN=https://dangngochai.io.vn.
# Never commit a file containing real credentials.
# Frontend production uses relative /api and needs no VITE_* build secret.
# VITE_API_PROXY_TARGET=http://localhost:5000 is only for local Vite development.
# VPS image references BACKEND_IMAGE/WEB_IMAGE and PKH_ENV_FILE are set by deploy.sh.
# Confirm all shared service hostnames, ports and Traefik names on the VPS.
# GitHub/VPS SSH and registry variables are listed in DEPLOY_GUIDES.md, not this app env.
# ==== Server ====
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=0

# Local Compose host ports only (unused by production Compose)
WEB_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==== MongoDB 4.0 ====
# Production: URI of existing MongoDB 4.0 reachable on PKH_STORAGE_NETWORK.
# Include database name and credentials when required; never use localhost.
MONGO_URI=mongodb://mongo:27017/personal_knowledge_hub

# ==== JWT (production: two different random secrets, each at least 32 characters) ====
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=pkh_refresh_token

# ==== Google Identity Services (OAuth Web client ID) ====
# Add CLIENT_ORIGIN to Authorized JavaScript origins in Google Cloud.
# This ID-token callback flow needs no GOOGLE_CLIENT_SECRET or GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=

# ==== SMTP (required in production for email verification and OTP) ====
# 587 + false uses required STARTTLS; 465 + true uses TLS immediately.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Optional; defaults to EMAIL_USER.
EMAIL_FROM=

# ==== OTP (code length 6-8 digits; backend validates exact configured length) ====
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==== MinIO ====
# Production: hostname/port/credentials of existing shared MinIO on
# PKH_STORAGE_NETWORK. MINIO_PUBLIC_* must match its existing HTTPS route.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=pkh_admin
MINIO_SECRET_KEY=change_this_minio_secret
MINIO_BUCKET=pkh-storage

# ==== Uploads ====
MAX_FILE_SIZE_MB=1024
# Browser-facing MinIO/CDN host for signed avatar URLs. Production: existing
# HTTPS storage domain; its proxy must preserve signed Host and path.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MAX_FILES_PER_UPLOAD=20
# Storage allocation is managed per user in the admin UI; new accounts get 0 B.

# ==== Trash ====
TRASH_AUTO_PURGE_DAYS=30

# ==== Link preview ====
URL_FETCH_TIMEOUT_MS=8000

# ==== Production Compose inputs (set only in private VPS backend.env) ====
# Existing private network shared by MongoDB 4.0 and MinIO; distinct from web.
PKH_STORAGE_NETWORK=
# Names from the existing Traefik static configuration; never guess.
TRAEFIK_HTTPS_ENTRYPOINT=
TRAEFIK_CERT_RESOLVER=

# ==== Deployment inputs (GitHub Actions repository Variables/Secrets, NOT backend.env) ====
# Variables: VPS_HOST=<SSH host>, VPS_PORT=22 (workflow connects as deploy),
# VPS_DEPLOY_ROOT=/srv/pkh, DEPLOY_REGISTRY=ghcr|dockerhub,
# PUBLISH_DOCKERHUB=true|false, DOCKERHUB_NAMESPACE=your-namespace.
# Secrets: VPS_SSH_PRIVATE_KEY, VPS_SSH_KNOWN_HOSTS;
# optional Docker Hub: DOCKERHUB_USERNAME, DOCKERHUB_TOKEN.
# GITHUB_TOKEN is supplied by GitHub; do not create it in this file.
