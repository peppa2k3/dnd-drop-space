# ==== Server ====
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=0

# Host ports (Docker services stay on their internal ports)
WEB_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==== MongoDB ====
MONGO_URI=mongodb://mongo:27017/personal_knowledge_hub

# ==== JWT ====
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=pkh_refresh_token

# ==== Google Identity Services (Web client ID; no client secret/callback needed) ====
GOOGLE_CLIENT_ID=

# ==== SMTP (required for new email/password registrations) ====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Optional; defaults to EMAIL_USER.
EMAIL_FROM=

# ==== OTP  ====
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==== MinIO ====
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=pkh_admin
MINIO_SECRET_KEY=change_this_minio_secret
MINIO_BUCKET=pkh-storage

# ==== Uploads ====
MAX_FILE_SIZE_MB=1024
# Browser-facing MinIO/CDN host for signed avatar URLs. Production: HTTPS domain.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MAX_FILES_PER_UPLOAD=20
# Storage allocation is managed per user in the admin UI; new accounts get 0 B.

# ==== Trash ====
TRASH_AUTO_PURGE_DAYS=30

# ==== Link preview ====
URL_FETCH_TIMEOUT_MS=8000
